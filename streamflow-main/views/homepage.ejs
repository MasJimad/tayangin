    <!-- JAVASCRIPT FOR ACCORDION -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const faqQuestions = document.querySelectorAll('.faq-question');
			
			const platforms = ["YouTube", "Shopee", "TikTok", "Instagram", "Facebook"];
			let currentIndex = 0;
			const platformTextElement = document.getElementById('platform-text');

			// Fungsi untuk mengganti teks
			setInterval(() => {
				// 1. Pudarkan teks (hilang)
				platformTextElement.style.opacity = '0';
				
				// 2. Tunggu sebentar sampai teks benar-benar pudar, lalu ganti isinya
				setTimeout(() => {
					currentIndex = (currentIndex + 1) % platforms.length;
					platformTextElement.textContent = platforms[currentIndex];
					
					// 3. Munculkan kembali teks yang baru
					platformTextElement.style.opacity = '1';
				}, 400); // 400ms adalah waktu tunggu efek pudar

			}, 2500); // Teks akan berganti setiap 2,5 detik

            faqQuestions.forEach(question => {
                question.addEventListener('click', () => {
                    const answer = question.nextElementSibling;
                    const icon = question.querySelector('div:last-child');
                    
                    // Close all other open answers
                    document.querySelectorAll('.faq-answer').forEach(el => {
                        if (el !== answer) {
                            el.style.maxHeight = null;
                            el.previousElementSibling.querySelector('div:last-child').innerText = '+';
                        }
                    });

                    // Toggle current answer
                    if (answer.style.maxHeight) {
                        answer.style.maxHeight = null;
                        icon.innerText = '+';
                    } else {
                        answer.style.maxHeight = answer.scrollHeight + 'px';
                        icon.innerText = '−';
                    }
                });
            });
		
			const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const navWrapper = document.getElementById('nav-wrapper');
            const menuIcon = mobileMenuBtn.querySelector('i');

            mobileMenuBtn.addEventListener('click', () => {
                navWrapper.classList.toggle('active');
                
                // Toggle Icon Menu <-> Close (X)
                if (navWrapper.classList.contains('active')) {
                    menuIcon.classList.remove('ti-menu-2');
                    menuIcon.classList.add('ti-x');
                    document.body.style.overflowY = 'hidden'; // Kunci scroll halaman belakang
                } else {
                    menuIcon.classList.remove('ti-x');
                    menuIcon.classList.add('ti-menu-2');
                    document.body.style.overflowY = 'auto'; // Buka scroll halaman
                }
            });

            // Otomatis menutup menu jika mengklik salah satu link (khusus anchor link)
            const navLinks = navWrapper.querySelectorAll('a');
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    navWrapper.classList.remove('active');
                    menuIcon.classList.remove('ti-x');
                    menuIcon.classList.add('ti-menu-2');
                    document.body.style.overflowY = 'auto';
                });
            });
        });
    </script>
